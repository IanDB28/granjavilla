import wollok.game.*
import personaje.*
import cultivos.*

program farmville {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("ground.png")

	//  VISUALES
 	game.addVisualCharacter(personaje)

	// CONTROLES
	keyboard.m().onPressDo({
		personaje.plantarMaiz()
	})
	keyboard.r().onPressDo({
		personaje.regar()
	})
 	
 	//  COMIENZA
	game.start()
}
